---
import { useTranslations, tList, type Locale } from '../../lib/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = tList<{ title: string; desc: string }>(lang, 'features.items');

// One inline icon per feature (stroke, currentColor). Order matches en.json.
const icons = [
  'M3 5h18M3 12h12M3 19h18', // subtitles
  'M4 7h16M4 12h16M4 17h10|M18 15l2 2 2-2', // tiers/layers
  'M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3C9.5 5.7 9.5 18.3 12 21', // globe
  'M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6', // billing
  'M13 2L3 14h7l-1 8 10-12h-7l1-8z', // low latency / bolt
  'M4 4h16v12H4zM8 20h8M12 16v4', // browser-native
];

function renderIcon(i: number) {
  return (icons[i] ?? '').split('|');
}
---

<section class="features" id="features" aria-labelledby="features-title">
  <div class="container-page">
    <header class="section-head" data-reveal>
      <h2 id="features-title">{t('features.title')}</h2>
      <p>{t('features.subtitle')}</p>
    </header>

    <ul class="feature-grid">
      {
        items.map((item, i) => (
          <li class="feature-card glass" data-reveal>
            <span class="feature-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {renderIcon(i).map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .section-head {
    max-width: 42rem;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    margin: 0 0 0.75rem;
  }
  .section-head p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }
  .feature-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .feature-card {
    padding: 1.5rem;
  }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    margin-bottom: 1rem;
  }
  .feature-card h3 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
  }
  .feature-card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }
  @media (min-width: 640px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
