---
import { useTranslations, type Locale } from '../../lib/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// No latency stat: a millisecond figure on a marketing page is a promise measured on
// someone else's network, and we do not quote one anywhere else either. The catalogue
// size took its cell — a fact that cannot degrade.
const stats = ['languages', 'catalogue', 'tiers', 'p2p'] as const;
---

<section class="social" aria-label={t('social.title')}>
  <div class="container-page">
    <div class="social-strip glass" data-reveal>
      {
        stats.map((key) => (
          <div class="stat">
            <span class="stat-value">{t(`social.${key}.value`)}</span>
            <span class="stat-label">{t(`social.${key}.label`)}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .social {
    padding-top: 1rem;
  }
  .social-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    padding: 1.75rem 1.5rem;
    text-align: center;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 720px) {
    .social-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
