---
import Button from '../ui/Button.astro';
import { useTranslations, type Locale } from '../../lib/i18n';
import { APP_URL } from '../../lib/site';
import { icon } from '../../lib/icons';

// In-call control bar — same icons as the app (mic, camera, screen share, chat,
// leave). `leave` is the red hang-up; the rest are neutral controls.
const controls = [
  { name: 'mic', kind: 'neutral' },
  { name: 'video', kind: 'neutral' },
  { name: 'monitor', kind: 'neutral' },
  { name: 'chat', kind: 'neutral' },
  { name: 'leave', kind: 'leave' },
];

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Decorative call-grid tiles (pure CSS/SVG → zero CLS, no image requests).
const tiles = [
  { flag: '🇮🇹', name: 'Giulia', caption: 'Ciao a tutti!', sub: 'Hi everyone!' },
  { flag: '🇯🇵', name: 'Haru', caption: 'はじめまして', sub: 'Nice to meet you' },
  { flag: '🇪🇸', name: 'Mateo', caption: '¿Empezamos?', sub: 'Shall we start?' },
  { flag: '🇩🇪', name: 'Lena', caption: 'Klar, los geht’s', sub: 'Sure, let’s go' },
];
---

<section class="hero" data-hero>
  <div class="container-page hero-grid">
    <div class="hero-copy">
      <p class="hero-badge label-caps" data-reveal>{t('hero.badge')}</p>
      <h1 class="hero-title" data-reveal>
        {t('hero.title')}
        <span class="accent">{t('hero.titleAccent')}</span>
      </h1>
      <p class="hero-sub" data-reveal>{t('hero.subtitle')}</p>
      <div class="hero-cta" data-reveal>
        <Button href={APP_URL} variant="primary" rel="noopener">{t('hero.ctaPrimary')}</Button>
        <Button href="#how" variant="ghost">{t('hero.ctaSecondary')}</Button>
      </div>
      <p class="hero-note" data-reveal>{t('hero.note')}</p>
    </div>

    <div class="hero-visual" data-reveal aria-hidden="true">
      <div class="call glass glass-glow">
        <div class="call-grid">
          {
            tiles.map((tile) => (
              <div class="tile">
                <div class="tile-top">
                  <span class="tile-flag">{tile.flag}</span>
                  <span class="tile-name">{tile.name}</span>
                </div>
                <div class="tile-caption">
                  <span class="orig">{tile.caption}</span>
                  <span class="trans">{tile.sub}</span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="call-bar">
          {controls.map((c) => <span class={`ctrl ctrl-${c.kind}`} set:html={icon(c.name, 15)} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-badge {
    display: inline-block;
    margin-bottom: 1.25rem;
    color: var(--primary);
  }
  .hero-title {
    font-size: clamp(2.4rem, 6vw, 3.5rem);
    margin: 0 0 1.25rem;
  }
  .hero-title .accent {
    background: linear-gradient(120deg, var(--primary), var(--accent) 55%, var(--tertiary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Decorative call visual */
  .hero-visual {
    perspective: 1200px;
  }
  .call {
    padding: 1rem;
    border-radius: var(--radius-xl);
  }
  .call-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .tile {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    background:
      radial-gradient(
        120% 100% at 0% 0%,
        color-mix(in srgb, var(--primary) 22%, transparent),
        transparent 60%
      ),
      radial-gradient(
        120% 100% at 100% 100%,
        color-mix(in srgb, var(--accent) 22%, transparent),
        transparent 60%
      ),
      var(--base-2);
    padding: 0.7rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }
  .tile-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--ink);
  }
  .tile-flag {
    font-size: 1rem;
  }
  .tile-name {
    font-weight: 600;
  }
  .tile-caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.3;
  }
  .tile-caption .orig {
    color: var(--muted);
  }
  .tile-caption .trans {
    color: var(--tertiary);
    font-weight: 600;
  }
  .call-bar {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--glass-border);
  }
  .ctrl {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--glass-border);
    color: var(--ink);
  }
  .ctrl :global(.ico) {
    width: 15px;
    height: 15px;
  }
  .ctrl-leave {
    background: #ef4444;
    border-color: transparent;
    color: #fff;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
