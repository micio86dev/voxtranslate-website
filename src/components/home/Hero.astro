---
import Button from '../ui/Button.astro';
import { useTranslations, type Locale } from '../../lib/i18n';
import { APP_URL } from '../../lib/site';
import { icon } from '../../lib/icons';

// In-call control bar — same icons as the app (mic, camera, screen share, chat,
// leave). Mic + camera are green (active/on), `leave` is the red hang-up, the
// rest are neutral.
const controls = [
  { name: 'mic', kind: 'success' },
  { name: 'video', kind: 'success' },
  { name: 'monitor', kind: 'neutral' },
  { name: 'chat', kind: 'neutral' },
  { name: 'leave', kind: 'leave' },
];

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Decorative call-grid tiles. Faces are synthetic (AI-generated, not real
// people); fixed dimensions + aspect-ratio keep CLS at zero.
const tiles = [
  {
    flag: '🇮🇹',
    name: 'Giulia',
    caption: 'Ciao a tutti!',
    sub: 'Hi everyone!',
    img: '/people/giulia.webp',
  },
  {
    flag: '🇯🇵',
    name: 'Haru',
    caption: 'はじめまして',
    sub: 'Nice to meet you',
    img: '/people/haru.webp',
  },
  {
    flag: '🇪🇸',
    name: 'Mateo',
    caption: '¿Empezamos?',
    sub: 'Shall we start?',
    img: '/people/mateo.webp',
  },
  {
    flag: '🇩🇪',
    name: 'Lena',
    caption: 'Klar, los geht’s',
    sub: 'Sure, let’s go',
    img: '/people/lena.webp',
  },
];
---

<section class="hero" data-hero>
  <div class="container-page hero-grid">
    <div class="hero-copy">
      <p class="hero-badge label-caps" data-reveal>{t('hero.badge')}</p>
      <h1 class="hero-title" data-reveal>
        {t('hero.title')}
        <span class="accent">{t('hero.titleAccent')}</span>
      </h1>
      <p class="hero-sub" data-reveal>{t('hero.subtitle')}</p>
      <div class="hero-cta" data-reveal>
        <Button
          href={APP_URL}
          variant="primary"
          rel="noopener"
          data-track-cta="try_free"
          data-track-location="hero">{t('hero.ctaPrimary')}</Button
        >
        <Button href="#how" variant="ghost">{t('hero.ctaSecondary')}</Button>
      </div>
      <p class="hero-note" data-reveal>{t('hero.note')}</p>
    </div>

    <div class="hero-visual" data-reveal aria-hidden="true">
      <div class="call glass glass-glow">
        <div class="call-grid">
          {
            tiles.map((tile) => (
              <div class="tile">
                <img
                  class="tile-photo"
                  src={tile.img}
                  alt=""
                  width="240"
                  height="240"
                  loading="eager"
                  decoding="async"
                />
                <div class="tile-top">
                  <span class="tile-flag">{tile.flag}</span>
                  <span class="tile-name">{tile.name}</span>
                  <span class="tile-live" />
                </div>
                <div class="tile-caption">
                  <span class="orig">{tile.caption}</span>
                  <span class="trans">{tile.sub}</span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="call-bar">
          {controls.map((c) => <span class={`ctrl ctrl-${c.kind}`} set:html={icon(c.name, 15)} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-badge {
    display: inline-block;
    margin-bottom: 1.25rem;
    color: var(--primary);
  }
  .hero-title {
    font-size: clamp(2.4rem, 6vw, 3.5rem);
    margin: 0 0 1.25rem;
  }
  .hero-title .accent {
    background: linear-gradient(120deg, var(--primary), var(--accent) 55%, var(--tertiary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 0 2rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero-note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Decorative call visual */
  .hero-visual {
    perspective: 1200px;
  }
  .call {
    padding: 1rem;
    border-radius: var(--radius-xl);
  }
  .call-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .tile {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    background:
      radial-gradient(
        120% 100% at 0% 0%,
        color-mix(in srgb, var(--primary) 22%, transparent),
        transparent 60%
      ),
      radial-gradient(
        120% 100% at 100% 100%,
        color-mix(in srgb, var(--accent) 22%, transparent),
        transparent 60%
      ),
      var(--base-2);
    padding: 0.7rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .tile-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
    z-index: 0;
  }
  /* Scrim keeps the name + captions legible over the photo. */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(8, 12, 28, 0.52) 0%,
      rgba(8, 12, 28, 0.05) 28%,
      rgba(8, 12, 28, 0.14) 48%,
      rgba(8, 12, 28, 0.86) 100%
    );
  }
  .tile-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
  }
  .tile-flag {
    font-size: 1rem;
  }
  .tile-name {
    font-weight: 600;
  }
  /* Live indicator — a small green dot with a radar pulse, top-right of the
     tile. The global prefers-reduced-motion rule stops the pulse (static dot). */
  .tile-live {
    position: relative;
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: auto;
    border-radius: 50%;
    background: #22c55e;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.2),
      0 0 6px rgba(34, 197, 94, 0.6);
  }
  .tile-live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: tile-live-pulse 2.4s ease-out infinite;
  }
  .tile:nth-child(2) .tile-live::after {
    animation-delay: 0.6s;
  }
  .tile:nth-child(3) .tile-live::after {
    animation-delay: 1.2s;
  }
  .tile:nth-child(4) .tile-live::after {
    animation-delay: 1.8s;
  }
  @keyframes tile-live-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .tile-caption {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.72rem;
    line-height: 1.3;
  }
  .tile-caption .orig {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  .tile-caption .trans {
    color: color-mix(in srgb, var(--tertiary) 60%, #fff);
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  /* On phones the call mock shrinks to two narrow tiles — tighten the padding
     and nudge the labels up a touch so they stay comfortably readable. */
  @media (max-width: 600px) {
    .tile {
      padding: 0.6rem;
    }
    .tile-top {
      font-size: 0.84rem;
    }
    .tile-caption {
      font-size: 0.78rem;
    }
  }
  .call-bar {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--glass-border);
  }
  .ctrl {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--glass-border);
    color: var(--ink);
  }
  .ctrl :global(.ico) {
    width: 15px;
    height: 15px;
  }
  .ctrl-success {
    background: #22c55e;
    border-color: transparent;
    color: #fff;
  }
  .ctrl-leave {
    background: #ef4444;
    border-color: transparent;
    color: #fff;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
