---
import Button from '../ui/Button.astro';
import { useTranslations, localizePath, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="biz-band" aria-labelledby="biz-band-title">
  <div class="container-page">
    <div class="biz-band-card glass glass-glow" data-reveal>
      <div class="biz-band-copy">
        <span class="badge badge-accent">{t('business.hero.badge')}</span>
        <h2 id="biz-band-title">{t('business.hero.title')}</h2>
        <p>{t('business.hero.subtitle')}</p>
      </div>
      <Button href={localizePath(lang, 'business')} variant="primary" class="biz-band-cta">
        {t('nav.business')}
      </Button>
    </div>
  </div>
</section>

<style>
  .biz-band {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .biz-band-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    align-items: flex-start;
  }
  .biz-band-copy h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    margin: 0.75rem 0 0.5rem;
  }
  .biz-band-copy p {
    color: var(--muted);
    margin: 0;
    max-width: 46rem;
  }
  .biz-band-cta {
    flex-shrink: 0;
  }
  @media (min-width: 860px) {
    .biz-band-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
