---
import { useTranslations, tList, type Locale } from '../../lib/i18n';
import { icon } from '../../lib/icons';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

type Item = { badge: 'free' | 'paid'; title: string; desc: string };
const items = tList<Item>(lang, 'highlights.items');

// Icons (app set) in the same order as highlights.items.
const icons = ['users', 'recording', 'subtitle', 'sparkles', 'mail'];
---

<section class="highlights" aria-labelledby="highlights-title">
  <div class="container-page">
    <header class="section-head" data-reveal>
      <h2 id="highlights-title">{t('highlights.title')}</h2>
      <p>{t('highlights.subtitle')}</p>
    </header>

    <ul class="hl-grid">
      {
        items.map((item, i) => (
          <li class="hl-card glass" data-reveal>
            <div class="hl-top">
              <span
                class="hl-icon"
                aria-hidden="true"
                set:html={icon(icons[i] ?? 'sparkles', 22)}
              />
              <span class={`hl-badge hl-${item.badge}`}>
                {item.badge === 'free' ? t('highlights.free') : t('highlights.paid')}
              </span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .section-head {
    max-width: 42rem;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    margin: 0 0 0.75rem;
  }
  .section-head p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }
  .hl-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .hl-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .hl-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .hl-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .hl-icon :global(.ico) {
    width: 22px;
    height: 22px;
  }
  .hl-badge {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .hl-free {
    color: #16a34a;
    background: color-mix(in srgb, #22c55e 16%, transparent);
    border-color: color-mix(in srgb, #22c55e 35%, transparent);
  }
  :global(.dark) .hl-free {
    color: #4ade80;
  }
  .hl-paid {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    border-color: color-mix(in srgb, var(--primary) 35%, transparent);
  }
  .hl-card h3 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
  }
  .hl-card p {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }
  @media (min-width: 640px) {
    .hl-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .hl-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
