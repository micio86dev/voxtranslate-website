---
import { localizePath, type Locale } from '../../lib/i18n';
interface Props {
  lang: Locale;
  label: string;
}
const { lang, label } = Astro.props;
---

<a class="logo" href={localizePath(lang)} aria-label={label}>
  <svg class="logo-mark" width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="vox-grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop stop-color="#3894ff"></stop>
        <stop offset="0.55" stop-color="#7c3aed"></stop>
        <stop offset="1" stop-color="#06b6d4"></stop>
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#vox-grad)"></rect>
    <!-- Stylised sound waves -->
    <g stroke="#fff" stroke-width="2.2" stroke-linecap="round">
      <path d="M9 16h0.5"></path>
      <path d="M13 12v8"></path>
      <path d="M17 9v14"></path>
      <path d="M21 12v8"></path>
      <path d="M24.5 16h0.5"></path>
    </g>
  </svg>
  <span class="logo-word">Vox<span class="logo-accent">Translate</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .logo-mark {
    border-radius: 9px;
    box-shadow: 0 0 18px var(--glow);
    flex-shrink: 0;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .logo-accent {
    color: var(--primary);
  }
</style>
