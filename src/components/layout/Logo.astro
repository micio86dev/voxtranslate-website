---
import { localizePath, type Locale } from '../../lib/i18n';
interface Props {
  lang: Locale;
  label: string;
}
const { lang, label } = Astro.props;
---

<a class="logo" href={localizePath(lang)} aria-label={label}>
  <img class="logo-mark" src="/icon.png" alt="" width="32" height="32" decoding="async" />
  <span class="logo-word">Vox<span class="logo-accent">Translate</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .logo-mark {
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    flex-shrink: 0;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .logo-accent {
    color: var(--primary);
  }
</style>
