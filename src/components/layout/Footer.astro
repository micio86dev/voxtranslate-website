---
import Logo from './Logo.astro';
import LangSwitcher from '../ui/LangSwitcher.astro';
import { useTranslations, localizePath, type Locale } from '../../lib/i18n';
import { APP_URL, LEGAL_URLS, SOCIAL, type SocialNetwork } from '../../lib/site';
import { GUIDES_URL } from '../../lib/seo-routes';
import { brandIcon } from '../../lib/icons';

interface Props {
  lang: Locale;
  pathWithoutLocale?: string;
  pathByLocale?: Partial<Record<Locale, string>>;
}
const { lang, pathWithoutLocale = '', pathByLocale } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const product = [
  { href: `${localizePath(lang)}#features`, label: t('footer.links.features') },
  { href: `${localizePath(lang)}chrome/`, label: t('footer.links.chrome') },
  { href: `${localizePath(lang)}pricing/`, label: t('footer.links.pricing') },
  { href: localizePath(lang, 'blog'), label: t('footer.links.blog') },
  // Non-localized: the guides hub lives in the English-only SEO tree (AGENTS.md §1).
  { href: GUIDES_URL, label: t('footer.links.guides') },
  { href: APP_URL, label: t('footer.links.app'), external: true },
];

// Order comes from SOCIAL. Each entry needs a matching `a11y.social.*` key and a
// glyph in `brandIcon()`; an icon-only link with no accessible name is invisible
// to a screen reader, so the label is not optional.
const socials = (Object.keys(SOCIAL) as SocialNetwork[]).map((key) => ({
  key,
  href: SOCIAL[key],
  label: t(`a11y.social.${key}`),
}));
const legal = [
  { href: LEGAL_URLS.privacy, label: t('footer.links.privacy') },
  { href: LEGAL_URLS.terms, label: t('footer.links.terms') },
  { href: LEGAL_URLS.acceptableUse, label: t('footer.links.acceptableUse') },
];
---

<footer class="site-footer">
  <div class="container-page footer-grid">
    <div class="footer-brand">
      <Logo lang={lang} label={t('a11y.homeLink')} />
      <p>{t('footer.tagline')}</p>
      <LangSwitcher lang={lang} pathWithoutLocale={pathWithoutLocale} pathByLocale={pathByLocale} />

      <!-- No visible <h2> here, unlike the other footer navs: the icons are the
           content, and `aria-label` already gives the region its accessible name. -->
      <nav class="footer-social" aria-label={t('footer.social')}>
        <ul>
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  title={s.label}
                >
                  <Fragment set:html={brandIcon(s.key)} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <nav aria-label={t('footer.product')}>
      <h2>{t('footer.product')}</h2>
      <ul>
        {
          product.map((l) => (
            <li>
              <a href={l.href} rel={l.external ? 'noopener' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={t('footer.legal')}>
      <h2>{t('footer.legal')}</h2>
      <ul>
        {
          legal.map((l) => (
            <li>
              <a href={l.href} rel="noopener">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container-page footer-bottom">
    <span>© {year} VoxTranslate. {t('footer.rights')}</span>
    <button type="button" id="vox-consent-reopen" class="footer-cookies">
      {t('footer.links.cookies')}
    </button>
    <span class="footer-motto">{t('footer.builtWith')}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--base-2) 60%, transparent);
    padding-block: 3rem 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .footer-brand p {
    margin: 1rem 0 1.25rem;
    color: var(--muted);
    max-width: 22rem;
    line-height: 1.6;
  }
  .site-footer h2 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .site-footer ul a {
    color: var(--ink);
    font-size: 0.95rem;
  }
  .site-footer ul a:hover {
    color: var(--primary);
  }
  /* Social row. Overrides the column layout the sibling navs use — these are
     icons in a line, and the 44px hit area is the WCAG 2.5.8 target size, not a
     visual choice. */
  .footer-social {
    margin-top: 1.5rem;
  }
  .footer-social ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 0.65rem;
    border: 1px solid var(--glass-border);
    color: var(--muted);
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }
  .footer-social a:hover {
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .footer-social a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-social a {
      transition: none;
    }
    .footer-social a:hover {
      transform: none;
    }
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--glass-border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer-motto {
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
  }
  .footer-cookies {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
  }
  .footer-cookies:hover {
    color: var(--primary);
  }
  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
