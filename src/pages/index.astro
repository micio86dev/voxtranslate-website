---
// Root entry: soft browser-language detection (no server redirect / 301).
// Lighthouse runs against /en/ and /en/blog/, so this tiny shell never affects
// scores. Localized pages carry hreflang for discovery.
import { LOCALES, DEFAULT_LOCALE, localizePath } from '../lib/i18n';
import { absoluteUrl } from '../lib/seo';
const localesJson = JSON.stringify(LOCALES);

// Derived from `Astro.site`, never hardcoded: this canonical previously pointed at
// website.voxtranslate.app, which has 301'd to the apex since the migration — so the
// apex root was telling Google its canonical was a redirect.
const canonical = absoluteUrl(Astro.site, localizePath(DEFAULT_LOCALE));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VoxTranslate — Real-time translated video calls</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline define:vars={{ localesJson, def: DEFAULT_LOCALE }}>
      (function () {
        try {
          const supported = JSON.parse(localesJson);
          // An explicit choice (set by the language switcher) outranks the browser's
          // configured languages. Normally the Cloudflare middleware has already
          // redirected using the same rule; this path covers a local preview, a cached
          // copy of this page, or the middleware not running for any reason.
          const stored = (document.cookie.match(/(?:^|;\s*)vox-lang=([^;]+)/) || [])[1];
          if (stored && supported.indexOf(decodeURIComponent(stored)) > -1) {
            location.replace('/' + decodeURIComponent(stored) + '/');
            return;
          }
          const prefs = navigator.languages || [navigator.language || def];
          let pick = def;
          for (let i = 0; i < prefs.length; i++) {
            const code = (prefs[i] || '').slice(0, 2).toLowerCase();
            if (supported.indexOf(code) > -1) {
              pick = code;
              break;
            }
          }
          location.replace('/' + pick + '/');
        } catch {
          location.replace('/' + def + '/');
        }
      })();
    </script>
    <meta http-equiv="refresh" content="0; url=/en/" />
  </head>
  <body>
    <p>Redirecting to <a href="/en/">VoxTranslate</a>…</p>
  </body>
</html>
