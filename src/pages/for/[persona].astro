---
/**
 * `/for/{persona}/` — use-case landing pages (event organisers, distributed teams,
 * sales orgs…).
 *
 * Mid-funnel: the visitor knows they have a language problem but has not yet framed it as
 * a product category. These pages exist to convert that intent, not to rank for volume.
 *
 * `PERSONAS` is empty until task 02/03 fills it, so this route builds zero pages today.
 */
import SeoLayout from '../../layouts/SeoLayout.astro';
import { PERSONAS, personaUrl } from '../../lib/seo-routes';

export function getStaticPaths() {
  return PERSONAS.map((p) => ({ params: { persona: p.slug }, props: { persona: p } }));
}

const { persona } = Astro.props;
const title = `Live meeting translation for ${persona.name}`;
const description = `How ${persona.name} use real-time voice translation, and what it changes in practice.`;
---

<SeoLayout title={title} description={description} path={personaUrl(persona.slug)}>
  <div class="wrap">
    <h1>{title}</h1>
    <slot />
  </div>
</SeoLayout>

<style>
  .wrap {
    max-width: 72ch;
    margin-inline: auto;
    padding: 3rem 1.25rem;
  }
</style>
