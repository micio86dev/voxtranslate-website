---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { useTranslations, localizePath, DEFAULT_LOCALE } from '../lib/i18n';

const lang = DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('notFound.title')} — VoxTranslate`}
  description={t('notFound.subtitle')}
  pathWithoutLocale="404"
  noindex={true}
>
  <section class="notfound">
    <div class="container-page">
      <p class="code">404</p>
      <h1>{t('notFound.title')}</h1>
      <p class="sub">{t('notFound.subtitle')}</p>
      <Button href={localizePath(lang)} variant="primary">{t('notFound.back')}</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: clamp(4rem, 14vw, 9rem);
  }
  .code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4rem, 18vw, 9rem);
    line-height: 1;
    margin: 0;
    background: linear-gradient(120deg, var(--primary), var(--accent) 55%, var(--tertiary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .notfound h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0.5rem 0 0.75rem;
  }
  .sub {
    color: var(--muted);
    margin: 0 0 2rem;
  }
</style>
