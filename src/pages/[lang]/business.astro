---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
import {
  LOCALES,
  useTranslations,
  tList,
  isLocale,
  DEFAULT_LOCALE,
  type Locale,
} from '../../lib/i18n';
import { DASHBOARD_URL, CONTACT_EMAIL, API_BASE } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
const lang: Locale = isLocale(langParam) ? langParam : DEFAULT_LOCALE;
const t = useTranslations(lang);

const features = tList<{ icon: string; title: string; desc: string }>(
  lang,
  'business.features.items',
);
const plans = tList<{ name: string; price: string; points: string[]; annual?: string }>(
  lang,
  'business.pricing.plans',
);
const rows = tList<{ feature: string; vox: string; meet: string }>(lang, 'business.compare.rows');
const POPULAR = 0; // Business
const mailto = `mailto:${CONTACT_EMAIL}`;
---

<BaseLayout
  lang={lang}
  title={t('meta.business.title')}
  description={t('meta.business.description')}
  pathWithoutLocale="business"
>
  <!-- Hero -->
  <section class="biz-hero">
    <div class="container-page" data-reveal>
      <span class="badge badge-accent">{t('business.hero.badge')}</span>
      <h1>{t('business.hero.title')}</h1>
      <p class="biz-sub">{t('business.hero.subtitle')}</p>
      <div class="biz-cta-row">
        <Button href={`${DASHBOARD_URL}/`} variant="primary" rel="noopener">
          {t('business.hero.ctaPrimary')}
        </Button>
        <Button href="#contact" variant="ghost">{t('business.hero.ctaSecondary')}</Button>
      </div>
    </div>
  </section>

  <!-- Features (3 columns) -->
  <section class="biz-features">
    <div class="container-page">
      <header class="section-head" data-reveal>
        <h2>{t('business.features.title')}</h2>
      </header>
      <ul class="biz-feature-grid">
        {
          features.map((f) => (
            <li class="biz-feature glass" data-reveal>
              <span class="biz-feature-icon" aria-hidden="true">
                {f.icon}
              </span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pricing -->
  <section class="biz-pricing" id="pricing">
    <div class="container-page">
      <header class="section-head" data-reveal>
        <h2>{t('business.pricing.title')}</h2>
        <p>{t('business.pricing.subtitle')}</p>
      </header>
      <ul class="biz-plan-grid">
        {
          plans.map((plan, i) => (
            <li
              class={`biz-plan glass ${i === POPULAR ? 'biz-plan-popular glass-glow' : ''}`}
              data-reveal
            >
              {i === POPULAR && (
                <span class="biz-flag badge badge-accent">{t('business.pricing.popular')}</span>
              )}
              <h3 class="biz-plan-name">{plan.name}</h3>
              <p class="biz-plan-price">
                <span class="biz-price">{plan.price}</span>
                <span class="biz-per">{t('business.pricing.perMonth')}</span>
              </p>
              {plan.annual && <p class="biz-annual">{plan.annual}</p>}
              <ul class="biz-plan-points">
                {plan.points.map((p) => (
                  <li>
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <Button
                href={`${DASHBOARD_URL}/`}
                variant={i === POPULAR ? 'primary' : 'ghost'}
                rel="noopener"
                class="biz-plan-cta"
              >
                {t('business.pricing.cta')}
              </Button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="biz-compare">
    <div class="container-page">
      <header class="section-head" data-reveal>
        <h2>{t('business.compare.title')}</h2>
      </header>
      <div class="biz-table-wrap glass" data-reveal>
        <table class="biz-table">
          <thead>
            <tr>
              <th scope="col">{t('business.compare.feature')}</th>
              <th scope="col" class="biz-col-vox">{t('business.compare.vox')}</th>
              <th scope="col">{t('business.compare.meet')}</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.feature}</th>
                  <td class="biz-col-vox">
                    {r.vox === 'yes' ? (
                      <span class="biz-yes" aria-label="Yes">
                        ✓
                      </span>
                    ) : r.vox === 'no' ? (
                      <span class="biz-no" aria-label="No">
                        ✗
                      </span>
                    ) : (
                      r.vox
                    )}
                  </td>
                  <td>
                    {r.meet === 'yes' ? (
                      <span class="biz-yes" aria-label="Yes">
                        ✓
                      </span>
                    ) : r.meet === 'no' ? (
                      <span class="biz-no" aria-label="No">
                        ✗
                      </span>
                    ) : (
                      r.meet
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Contact form -->
  <section class="biz-contact" id="contact">
    <div class="container-page">
      <header class="section-head" data-reveal>
        <h2>{t('business.contact.title')}</h2>
        <p>{t('business.contact.subtitle')}</p>
      </header>
      <form
        class="biz-contact-form glass"
        id="contact-form"
        data-reveal
        novalidate
        data-endpoint={`${API_BASE}/api/contact`}
        data-sending={t('business.contact.sending')}
        data-success={t('business.contact.success')}
        data-error={t('business.contact.error')}
        data-mailto={mailto}
      >
        <div class="biz-field">
          <label for="cf-name">{t('business.contact.name')}</label>
          <input
            id="cf-name"
            name="name"
            type="text"
            required
            maxlength="200"
            autocomplete="name"
          />
        </div>
        <div class="biz-field">
          <label for="cf-email">{t('business.contact.email')}</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="biz-field">
          <label for="cf-company">{t('business.contact.company')}</label>
          <input id="cf-company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="biz-field">
          <label for="cf-message">{t('business.contact.message')}</label>
          <textarea id="cf-message" name="message" rows="5" required maxlength="4000"></textarea>
        </div>
        <Button type="submit" variant="primary" class="biz-contact-submit" id="cf-submit">
          {t('business.contact.submit')}
        </Button>
        <p class="biz-contact-status" id="cf-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="biz-final">
    <div class="container-page" data-reveal>
      <div class="biz-final-card glass glass-glow">
        <h2>{t('business.cta.title')}</h2>
        <p>{t('business.cta.subtitle')}</p>
        <Button href={`${DASHBOARD_URL}/`} variant="primary" rel="noopener">
          {t('business.cta.button')}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/animations';
</script>

<script>
  import { track, trackFB } from '../../scripts/analytics';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const status = document.getElementById('cf-status');
    const endpoint = form.dataset.endpoint ?? '';
    const msgSending = form.dataset.sending ?? 'Sending…';
    const msgSuccess = form.dataset.success ?? 'Thanks — we will be in touch soon.';
    const msgError = form.dataset.error ?? 'Something went wrong. Please try again.';
    const mailto = form.dataset.mailto ?? '';
    const submitLabel = submit?.textContent ?? 'Send message';

    const setStatus = (text: string, kind: 'error' | 'success' | '') => {
      if (!status) return;
      status.textContent = text;
      status.classList.toggle('is-error', kind === 'error');
      status.classList.toggle('is-success', kind === 'success');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        company: String(data.get('company') ?? '').trim(),
        message: String(data.get('message') ?? '').trim(),
      };

      if (submit) {
        submit.disabled = true;
        submit.textContent = msgSending;
      }
      setStatus('', '');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        form.reset();
        setStatus(msgSuccess, 'success');
        // The site's only real conversion: a B2B enquiry that reached the API. Reported
        // to Meta as the standard `Lead` (standard events are what campaign optimisation
        // can bid on) and to GA4 as `generate_lead`, its recommended name. Both no-op
        // until the visitor accepts the consent banner, which is what loads the tags.
        trackFB('Lead');
        track('generate_lead', { form: 'business_contact' });
      } catch {
        const fallback = mailto ? `${msgError} ` : msgError;
        setStatus(fallback, 'error');
        if (status && mailto) {
          const a = document.createElement('a');
          a.href = mailto;
          a.textContent = mailto.replace('mailto:', '');
          a.style.textDecoration = 'underline';
          status.appendChild(a);
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  }
</script>

<style>
  .biz-hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
    text-align: center;
  }
  .biz-hero h1 {
    font-size: clamp(2rem, 6vw, 3.4rem);
    margin: 1rem auto 0.75rem;
    max-width: 18ch;
  }
  .biz-sub {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 44rem;
    margin: 0 auto 1.75rem;
  }
  .biz-cta-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .section-head {
    max-width: 42rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }
  .section-head h2 {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    margin: 0 0 0.5rem;
  }
  .section-head p {
    color: var(--muted);
    margin: 0;
  }
  .biz-features,
  .biz-pricing,
  .biz-compare {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .biz-feature-grid,
  .biz-plan-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .biz-feature {
    padding: 1.75rem 1.5rem;
  }
  .biz-feature-icon {
    font-size: 1.9rem;
  }
  .biz-feature h3 {
    margin: 0.75rem 0 0.4rem;
    font-size: 1.2rem;
  }
  .biz-feature p {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }
  .biz-plan {
    position: relative;
    padding: 1.9rem 1.6rem;
    display: flex;
    flex-direction: column;
  }
  .biz-plan-popular {
    border-color: color-mix(in srgb, var(--primary) 55%, var(--glass-border));
  }
  .biz-flag {
    position: absolute;
    top: -0.75rem;
    left: 1.6rem;
  }
  .biz-plan-name {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }
  .biz-plan-price {
    margin: 0 0 0.3rem;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }
  .biz-price {
    font-size: 2.2rem;
    font-weight: 700;
  }
  .biz-per {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .biz-annual {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .biz-plan-points {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .biz-plan-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .biz-plan-points svg {
    color: var(--tertiary);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .biz-plan-cta {
    width: 100%;
  }
  .biz-table-wrap {
    overflow-x: auto;
    padding: 0.5rem;
  }
  .biz-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .biz-table th,
  .biz-table td {
    padding: 0.85rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--glass-border);
  }
  .biz-table thead th {
    color: var(--muted);
    font-weight: 600;
  }
  .biz-table tbody th {
    font-weight: 500;
  }
  .biz-table tr:last-child th,
  .biz-table tr:last-child td {
    border-bottom: none;
  }
  .biz-col-vox {
    background: color-mix(in srgb, var(--primary) 6%, transparent);
  }
  .biz-yes {
    color: var(--tertiary);
    font-weight: 700;
  }
  .biz-no {
    color: var(--muted);
  }
  .biz-contact {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .biz-contact-form {
    max-width: 36rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .biz-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .biz-field label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .biz-field input,
  .biz-field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: inherit;
    font: inherit;
    transition: border-color 0.15s ease;
  }
  .biz-field input:focus,
  .biz-field textarea:focus {
    outline: none;
    border-color: color-mix(in srgb, var(--primary) 60%, var(--glass-border));
  }
  .biz-field textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .biz-contact-submit {
    width: 100%;
    margin-top: 0.25rem;
  }
  .biz-contact-status {
    margin: 0;
    min-height: 1.2rem;
    font-size: 0.9rem;
    text-align: center;
  }
  .biz-contact-status.is-error {
    color: #ef4444;
  }
  .biz-contact-status.is-success {
    color: var(--tertiary);
  }
  .biz-final {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .biz-final-card {
    text-align: center;
    padding: clamp(2rem, 5vw, 3.5rem);
  }
  .biz-final-card h2 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin: 0 0 0.5rem;
  }
  .biz-final-card p {
    color: var(--muted);
    max-width: 40rem;
    margin: 0 auto 1.5rem;
  }
  @media (min-width: 720px) {
    .biz-feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .biz-plan-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 56rem;
      margin-inline: auto;
    }
  }
</style>
