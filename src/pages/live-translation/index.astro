---
/**
 * `/live-translation/` — the pillar hub.
 *
 * AGENTS.md R6 bans dedicated pages for head terms; this hub is its single stated
 * exception. It exists to hold the internal-link graph together (every pair and platform
 * page links back here) and to give the cluster one canonical entry point — not to
 * compete for "live translation", which DeepL, Google and Wordly already own.
 *
 * It renders with zero children today. That is intended: the scaffolding ships in task
 * 00, the pages arrive in tasks 02-05.
 */
import { getCollection } from 'astro:content';
import SeoLayout from '../../layouts/SeoLayout.astro';
import { softwareAppJsonLd } from '../../lib/seo';
import {
  isPublished,
  pairUrl,
  platformUrl,
  personaUrl,
  PLATFORMS,
  PERSONAS,
  LANGUAGES_URL,
  LATENCY_URL,
  GUIDES_URL,
  LIVE_TRANSLATION_HUB,
} from '../../lib/seo-routes';

const pairs = (await getCollection('pairs'))
  .filter((e) => isPublished(e.data))
  .sort((a, b) => a.id.localeCompare(b.id));

// Use-case landing pages, once they are live. The hub is the one page every cluster links
// back to, so it is where the internal-link graph is held together.
const personas = PERSONAS.filter((p) => isPublished(p));

const title = 'Live voice translation for video calls';
const description =
  'Real-time voice-to-voice translation for meetings: measured latency per language pair, ' +
  'published methodology, and a documented quality matrix.';
---

<SeoLayout
  title={title}
  description={description}
  path={LIVE_TRANSLATION_HUB}
  jsonLd={softwareAppJsonLd(Astro.site)}
>
  <div class="wrap">
    <h1>{title}</h1>
    <p>
      Two ways to get it. Run the call yourself, and everyone in the room speaks their own language.
      Or add <a href="/en/chrome/">VoxTranslate for Chrome</a> and translate the audio of a call, video
      or stream you were simply invited to — the platform integrations below cover where that applies.
    </p>
    <p>
      No latency figure is published anywhere on this site. The method that would produce one is
      public on <a href={LATENCY_URL}>the latency page</a>, and the per-pair quality tiers —
      including the ones that are not top tier — will appear on <a href={LANGUAGES_URL}
        >the language matrix</a
      > when the harness has run. Estimates are not published in the meantime.
    </p>

    {
      pairs.length > 0 && (
        <nav aria-labelledby="pairs-h">
          <h2 id="pairs-h">Language pairs</h2>
          <ul>
            {pairs.map((p) => (
              <li>
                <a href={pairUrl(p.id)}>
                  {p.data.source} to {p.data.target}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      personas.length > 0 && (
        <nav aria-labelledby="personas-h">
          <h2 id="personas-h">By use case</h2>
          <ul>
            {personas.map((p) => (
              <li>
                <a href={personaUrl(p.slug)}>For {p.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      PLATFORMS.length > 0 && (
        <nav aria-labelledby="platforms-h">
          <h2 id="platforms-h">Platform integrations</h2>
          <ul>
            {PLATFORMS.map((p) => (
              <li>
                <a href={platformUrl(p.slug)}>{p.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <nav aria-labelledby="guides-h">
      <h2 id="guides-h">Guides</h2>
      <p>
        Thirty-five practical guides — running a multilingual webinar, translating a Teams meeting,
        what to do when a platform's own feature does not cover your language pair.
      </p>
      <ul>
        <li><a href={GUIDES_URL}>Browse all guides</a></li>
      </ul>
    </nav>
  </div>
</SeoLayout>

<style>
  .wrap {
    max-width: 72ch;
    margin-inline: auto;
    padding: 3rem 1.25rem;
  }
  ul {
    padding-left: 1.25rem;
  }
</style>
