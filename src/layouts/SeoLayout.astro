---
/**
 * Layout for the non-localised SEO routes (docs/seo/AGENTS.md §3).
 *
 * Wraps BaseLayout with the three things every page in that architecture needs and must
 * not get wrong individually: a root-level canonical (not locale-prefixed), NO hreflang
 * (§1 — none until localisation actually exists), and a BreadcrumbList. Centralising them
 * means a new template cannot forget one.
 *
 * Chrome, fonts, consent and theming all come from BaseLayout, so these pages stay inside
 * the same performance budget as the rest of the site (R7).
 */
import BaseLayout from './BaseLayout.astro';
import { breadcrumbJsonLd, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Root-relative canonical path with a trailing slash. */
  path: string;
  /** Ancestors only — the current page is appended automatically. */
  crumbs?: Crumb[];
  /** Page-specific structured data (FAQPage, SoftwareApplication, …). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Set for entries with `publishedAt: null`, which must never be crawled. */
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, path, crumbs = [], jsonLd, noindex = false, ogImage } = Astro.props;

const trail: Crumb[] = [{ name: 'Home', path: '/en/' }, ...crumbs, { name: title, path }];

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [breadcrumbJsonLd(Astro.site, trail), ...extra];
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  canonicalPath={path}
  alternates={[]}
  jsonLd={structuredData}
  noindex={noindex}
  ogImage={ogImage}
>
  <div class="seo-body">
    <slot />
  </div>
</BaseLayout>

<style is:global>
  /*
    A typographic scale for the SEO tree.

    Tailwind's preflight resets every heading to `font-size: inherit`, and the base layer
    in global.css sets family, weight, colour and line-height for h1-h4 but deliberately
    no size — each home-page component defines its own. Pages rendered through this layout
    have no such component, so h1, h2, h3 and body text all shipped at 1rem: on
    /guides/, /alternatives/*, /compare/*, /for/* and every platform page, the headline was
    the same size as the paragraph under it.

    That is a hierarchy problem before it is a taste problem. The document outline was
    always correct — one h1, properly nested h2s — but nothing rendered it, so a sighted
    reader had to infer structure from bold text alone.

    `is:global` because the content arrives through a <slot/> and scoped styles do not
    reach it. Everything is confined to `.seo-body` so it cannot touch the header, footer,
    consent banner, or any page that already sets its own scale.
  */
  .seo-body h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    margin: 0 0 1rem;
  }
  .seo-body h2 {
    font-size: clamp(1.35rem, 3vw, 1.6rem);
    margin: 2.75rem 0 0.75rem;
  }
  .seo-body h3 {
    font-size: 1.12rem;
    margin: 1.75rem 0 0.5rem;
  }
  .seo-body p,
  .seo-body li {
    line-height: 1.7;
  }
  .seo-body p {
    margin: 0 0 1.1rem;
  }
  /* Inline prose links get an underline; a navigational list of links does not —
     thirty-five underlined titles on the guides hub is texture, not emphasis. Opt out
     with `.plain` where a link IS the block rather than sitting inside one. */
  .seo-body a:not(.btn):not(.plain) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .seo-body a:not(.btn):hover {
    color: var(--primary-hover);
  }
  /* Tap targets in navigational link lists.

     Lighthouse measured these at 21px tall with 6px between them on /live-translation/
     — below WCAG 2.5.8's 24px minimum and well below the 48px Google asks for. It was
     always true of the persona list; adding the platform and guides lists to the same
     page is what made it a failing audit rather than a latent one.

     Padding rather than a min-height so the text stays vertically centred in the target,
     and inline-block so the padding actually applies to an anchor. */
  .seo-body nav li {
    margin-block: 0.2rem;
  }
  .seo-body nav li a {
    display: inline-block;
    padding-block: 0.7rem;
    line-height: 1.3;
  }

  /* Tables appear on the comparison and language-matrix pages and must not push the
     page wide on a phone. */
  .seo-body table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    border-collapse: collapse;
  }
  .seo-body th,
  .seo-body td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--glass-border);
    white-space: nowrap;
  }
</style>
