---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { useTranslations, localizePath, type Locale, LOCALES } from '../lib/i18n';
import { absoluteUrl, buildAlternates, ogLocale, type Alternate } from '../lib/seo';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  pathWithoutLocale?: string;
  pathByLocale?: Partial<Record<Locale, string>>;
  ogImage?: string;
  ogType?: 'website' | 'article';
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Override hreflang alternates (e.g. single-language blog posts). */
  alternates?: Alternate[];
}

const {
  lang,
  title,
  description,
  pathWithoutLocale = '',
  pathByLocale,
  ogImage = '/og/default.png',
  ogType = 'website',
  article,
  jsonLd,
  noindex = false,
  alternates: alternatesOverride,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site;
const canonical = absoluteUrl(site, localizePath(lang, pathWithoutLocale));
const alternates = alternatesOverride ?? buildAlternates(site, pathWithoutLocale);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(site, ogImage);
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      (noindex || import.meta.env.PUBLIC_STAGING === 'true') && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    {/* hreflang alternates */}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    {/* Theme color follows OS chrome; in-page theme is class-based. */}
    <meta name="theme-color" content="#f6f9fe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0b10" media="(prefers-color-scheme: dark)" />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="VoxTranslate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {
      LOCALES.filter((l) => l !== lang).map((l) => (
        <meta property="og:locale:alternate" content={ogLocale(l)} />
      ))
    }
    {
      article?.publishedTime && (
        <meta property="article:published_time" content={article.publishedTime} />
      )
    }
    {
      article?.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )
    }
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Preload the two most critical fonts (hero headline + body). */}
    <link
      rel="preload"
      href="/fonts/sora-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* No-FOUC theme + progressive-enhancement classes (runs before paint). */}
    <script is:inline>
      (function () {
        const el = document.documentElement;
        el.classList.remove('no-js');
        el.classList.add('js');
        try {
          if (localStorage.getItem('vox-theme') === 'dark') el.classList.add('dark');
        } catch {}
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
            el.classList.add('reduce-motion');
        } catch {}
      })();
    </script>

    {
      jsonLdItems.map((item) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skipToContent')}</a>
    <Header lang={lang} pathWithoutLocale={pathWithoutLocale} pathByLocale={pathByLocale} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} pathWithoutLocale={pathWithoutLocale} pathByLocale={pathByLocale} />
    <ConsentBanner lang={lang} />

    <script is:inline define:vars={{ locales: LOCALES }}>
      // Remember the language actually being viewed, so the bare root sends the visitor
      // back to it. Covers both ways a language gets chosen: the switcher, and typing or
      // following a URL with a different locale prefix — the URL is the authority either
      // way, which is why this lives here rather than on the switcher's click.
      //
      // Only a real locale prefix counts: a 404 or the prefix-less landing page must not
      // rewrite the preference. Localized URLs stay honoured as-is (a shared /it/ link
      // opens in Italian whatever the cookie says); the cookie only decides where `/` goes.
      (function () {
        function remember() {
          try {
            const seg = location.pathname.split('/')[1];
            if (locales.indexOf(seg) === -1) return;
            const current = (document.cookie.match(/(?:^|;\s*)vox-lang=([^;]+)/) || [])[1];
            if (current === seg) return;
            const secure = location.protocol === 'https:' ? '; Secure' : '';
            document.cookie =
              'vox-lang=' + seg + '; Path=/; Max-Age=31536000; SameSite=Lax' + secure;
          } catch {
            /* storage blocked — the redirect just falls back to Accept-Language */
          }
        }
        remember();
        // A back/forward restore from the bfcache does not re-run inline scripts, so the
        // cookie would keep pointing at the page navigated away from.
        addEventListener('pageshow', function (e) {
          if (e.persisted) remember();
        });
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.7rem 1rem;
        background: var(--primary-strong);
        color: var(--on-primary);
        border-radius: 0 0 var(--radius) 0;
        font-weight: 600;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
