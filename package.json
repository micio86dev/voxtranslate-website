{
  "name": "voxtranslate-website",
  "type": "module",
  "version": "0.7.0",
  "private": true,
  "description": "VoxTranslate marketing site & blog",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
