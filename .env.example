# --- Origins (build-time; all default to production if unset) ----------------
# Every origin the site links to is overridable so a staging or preview build can
# point at itself instead of production. Unset ⇒ the production default, never
# localhost: this site builds on the host, and a missing variable must not bake a
# dead URL into the shipped HTML.
#
# PUBLIC_SITE_ORIGIN is read by BOTH src/lib/site.ts and astro.config.mjs (the
# config uses process.env — import.meta.env does not exist there). Keep in step.
PUBLIC_SITE_ORIGIN=https://voxtranslate.app
PUBLIC_APP_URL=https://app.voxtranslate.app
PUBLIC_DASHBOARD_URL=https://dashboard.voxtranslate.app
PUBLIC_API_BASE=https://api.voxtranslate.app
PUBLIC_CONTACT_EMAIL=business@voxtranslate.app

# The public Chrome Web Store listing. Overridable so a staging build can point at an
# unlisted test item instead of sending reviewers to the live one.
PUBLIC_CHROME_WEBSTORE_URL=https://chromewebstore.google.com/detail/voxtranslate/maabjjeohcieihdockimokcckcnjcmbb

# --- Frontend (build-time) ---------------------------------------------------
# Base URL of the PocketBase instance that serves blog content.
# Local dev:   http://127.0.0.1:8090
# Production:  https://<your-pocketbase>.up.railway.app  (or a Cloudflare-proxied host)
POCKETBASE_URL=http://127.0.0.1:8090

# Google Analytics 4 Measurement ID (G-XXXXXXX). Marketing tracker — loads only
# after cookie consent. Empty ⇒ never loads.
# NOTE: for production this must ALSO be set as a GitHub repo Variable, which
# deploy.yml passes into the build. It was missing there until 2026-08-26, so gtag.js
# never loaded on the live site and every track() call was a no-op.
PUBLIC_GA_ID=

# Google Ads tag id (AW-XXXXXXXXX) — conversion tracking / remarketing. Loads
# only after cookie consent, alongside GA4 (shared gtag.js). Empty ⇒ never loads.
# NOTE: for production, also set this in the Cloudflare Pages build environment.
PUBLIC_GOOGLE_ADS_ID=

# --- CI / Deploy (GitHub Actions secrets, never committed) --------------------
# Cloudflare Pages deploy via wrangler-action.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- PocketBase (Railway service env) ----------------------------------------
# Optional: Cloudflare Pages Deploy Hook called when a post is published, so the
# static site rebuilds. Set on the Railway PocketBase service, not here.
# CF_PAGES_DEPLOY_HOOK_URL=

# Offer the Pro tier on the marketing site. OFF unless truthy — mirrors the server's
# PRO_TIER_ENABLED, which is the enforcing side. Set BOTH or neither: advertising a tier
# the app will not start is worse than not advertising it.
PUBLIC_PRO_TIER_ENABLED=

# Staging only. Set on the Cloudflare Pages PREVIEW environment (not here) as `user:pass`.
# functions/_middleware.ts uses its presence to switch the deploy into staging mode:
# HTTP Basic Auth on every request and `X-Robots-Tag: noindex, nofollow` on every
# response, short-circuiting BEFORE the *.pages.dev → apex 301. Without it the preview
# deploy just redirects to production.
# STAGING_BASIC_AUTH=

# Set by the staging build in deploy.yml. Makes BaseLayout emit `noindex, nofollow`
# regardless of host, as a second line of defence behind the middleware header.
PUBLIC_STAGING=
