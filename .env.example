# --- Frontend (build-time) ---------------------------------------------------
# Base URL of the PocketBase instance that serves blog content.
# Local dev:   http://127.0.0.1:8090
# Production:  https://<your-pocketbase>.up.railway.app  (or a Cloudflare-proxied host)
POCKETBASE_URL=http://127.0.0.1:8090

# Google Analytics 4 Measurement ID (G-XXXXXXX). Marketing tracker — loads only
# after cookie consent. Empty ⇒ never loads.
PUBLIC_GA_ID=

# Google Ads tag id (AW-XXXXXXXXX) — conversion tracking / remarketing. Loads
# only after cookie consent, alongside GA4 (shared gtag.js). Empty ⇒ never loads.
# NOTE: for production, also set this in the Cloudflare Pages build environment.
PUBLIC_GOOGLE_ADS_ID=

# --- CI / Deploy (GitHub Actions secrets, never committed) --------------------
# Cloudflare Pages deploy via wrangler-action.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- PocketBase (Railway service env) ----------------------------------------
# Optional: Cloudflare Pages Deploy Hook called when a post is published, so the
# static site rebuilds. Set on the Railway PocketBase service, not here.
# CF_PAGES_DEPLOY_HOOK_URL=

# Offer the Pro tier on the marketing site. OFF unless truthy — mirrors the server's
# PRO_TIER_ENABLED, which is the enforcing side. Set BOTH or neither: advertising a tier
# the app will not start is worse than not advertising it.
PUBLIC_PRO_TIER_ENABLED=
